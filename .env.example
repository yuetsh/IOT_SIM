# 复制为 .env 后修改（.env 不进 git）。改完执行 docker compose up -d 生效。

# 老师账号（只有一个）。学生账号由老师登录后在"班级管理"里导入名单
TEACHER_USERNAME=admin
TEACHER_PASSWORD=请改成不容易猜到的密码

# AI 评阅：给老师评分项（界面、注释、命名）出建议分和评语，老师采纳后生效；不填就不做 AI 评阅
DEEPSEEK_API_KEY=
AI_MODEL=deepseek-flash

# 平台最多使用的内存
APP_MEM_LIMIT=4g

# 全站同时运行的学生程序上限，超过时提示"服务器繁忙"
SIM_MAX_RUNS=150
# 每个学生程序的内存上限（MB）
SIM_HEAP_LIMIT_MB=128
# 每次运行累计 CPU 时间上限（秒），防止死循环占满 CPU
SIM_CPU_LIMIT_SECONDS=120
# 每次运行最长时间（分钟）
SIM_MAX_RUN_MINUTES=60
# 全站同时跑几个评分检查项（提交评分和"自己检查"共用）；2 核服务器不要超过 24，CPU 不够会误判
SIM_GRADE_CONCURRENCY=16
